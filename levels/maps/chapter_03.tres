[resource]
script = ExtResource("1_data")
music = &"long_road"
music_after_switch = &"winter_pass"
title = "Chapter Three"
subtitle = "The Long Road"
night_text = "Six nights remain"
map_path = "res://levels/maps/chapter_03.txt"
dialogue_path = "res://story/chapter_03.txt"
outro_scene = "res://story/memories/memory_ribbon.tscn"
background_color = Color(0.82, 0.72, 0.52, 1)
tile_set = ExtResource("2_tiles")
terrain = 1
background_scene = ExtResource("3_background")
terrain_switch_column = 117
terrain_after_switch = 2
step_surface = "dirt"
step_surface_after_switch = "snow"
